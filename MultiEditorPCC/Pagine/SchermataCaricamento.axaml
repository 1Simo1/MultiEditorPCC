<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MultiEditorPCC.Pagine.SchermataCaricamento">
  <StackPanel Orientation="Vertical" VerticalAlignment="Center">
		<Image Source="avares://MultiEditorPCC/Assets/MultiEditorPCC.png" Width="64" Height="64" RenderTransformOrigin=".5,.5" />
		<TextBlock TextAlignment="Center" FontSize="21" Margin="0 21">
			Multi PCC Editor
		</TextBlock>
		
		<ProgressBar IsIndeterminate="True" Margin="21" 
					 Foreground="DarkGoldenrod"
					 Background="DarkGreen"
					 />
		
		</StackPanel>
</UserControl>
