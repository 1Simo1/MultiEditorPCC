<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:MultiEditorPCC.ViewModels"

             x:DataType="vm:MainViewModel"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:lng="clr-namespace:MultiEditorPCC.Locales;assembly=MultiEditorPCC"
             xmlns:pagine="using:MultiEditorPCC.Pagine"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             x:Class="MultiEditorPCC.Pagine.SquadreView">

    <StackPanel Orientation="Vertical" Margin="21">
        <TextBlock FontWeight="DemiBold"
                   Text="{Binding Testo,Converter={StaticResource LngConverter},ConverterParameter='Squadre'}" />
        <Grid Margin="21" RowDefinitions="Auto,*,21">

            <StackPanel Orientation="Horizontal" Grid.Row="0">

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Testo,Converter={StaticResource LngConverter},ConverterParameter='Scegli Squadra'}" />

                    <AutoCompleteBox ItemsSource="{Binding SquadreViewModel.ElencoSquadre,Mode=TwoWay}"
                                     ValueMemberBinding="{Binding Nome}"
                                     SelectedItem="{Binding SquadreViewModel.Squadra}"
                                     />


                    <ComboBox ItemsSource="{Binding SquadreViewModel.ElencoSquadre,Mode=TwoWay}"
                              SelectedItem="{Binding SquadreViewModel.Squadra,Mode=TwoWay}"
                           
                              >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nome}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>



                <Grid
                    IsVisible="{Binding SquadreViewModel.Squadra,
                    Converter={x:Static ObjectConverters.IsNotNull}}"
                    >

                    <TextBlock Text="{Binding SquadreViewModel.Squadra.Nome}" FontWeight="DemiBold"/>

                </Grid>

            </StackPanel>

            <Grid Grid.Row="1" Grid.ColumnDefinitions="210,*,Auto"
                  IsVisible="{Binding SquadreViewModel.Squadra,
                  Converter={x:Static ObjectConverters.IsNotNull}}">

                <ScrollViewer VerticalScrollBarVisibility="Visible" Height="521" Grid.Column="0">
                    <ListBox ItemsSource="{Binding SquadreViewModel.ElencoGiocatoriSquadra,Mode=TwoWay}"
                             SelectedItem="{Binding GiocatoriViewModel.Giocatore,Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nome,Mode=TwoWay}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>


                <pagine:SchedaGiocatore Grid.Column="1"
                                        IsVisible="{Binding GiocatoriViewModel.Giocatore,
                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                                        />
            </Grid>
            <!--

            <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0">
            <AutoCompleteBox ItemsSource="{Binding SquadreViewModel.ElencoSquadre,Mode=TwoWay}"
            SelectedItem="{Binding SquadreViewModel.Squadra.Nome}" />

            <ScrollViewer VerticalScrollBarVisibility="Visible" Height="1021">
            <ListBox ItemsSource="{Binding SquadreViewModel.ElencoSquadre,Mode=TwoWay}"
            SelectedItem="{Binding SquadreViewModel.Squadra,Mode=TwoWay}"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            >
            <ListBox.ItemTemplate>
            <DataTemplate>
            <TextBlock Text="{Binding Nome,Mode=TwoWay}" />
            </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
            </ScrollViewer>
            </StackPanel>


            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnDefinitions="Auto,*">
            <ScrollViewer VerticalScrollBarVisibility="Visible" Height="1021" Grid.Column="">
            <ListBox ItemsSource="{Binding SquadreViewModel.ElencoSquadre,Mode=TwoWay}"
            SelectedItem="{Binding SquadreViewModel.Squadra,Mode=TwoWay}"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            >
            <ListBox.ItemTemplate>
            <DataTemplate>
            <TextBlock Text="{Binding Nome,Mode=TwoWay}" />
            </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
            </ScrollViewer>
            </Grid>-->


















        </Grid>
    </StackPanel>

</UserControl>
